[Unit]
Description=Run one manager analysis request in the isolated sandbox

[Service]
Type=exec
LoadCredential=active-release:/opt/Mobiup/comenzi-distributie/runtime/current/RELEASE.json
ExecStart=/usr/bin/python3 -IB /opt/mobiup-analysis-runtime/analysis-broker-release.py launch %d/active-release /usr/bin/node
StandardInput=socket
StandardOutput=null
StandardError=journal
Environment=MOBIUP_MANAGER_AI_SANDBOX_ENABLED=1
DynamicUser=yes
User=comenzi-analysis
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
InaccessiblePaths=-/storage -/opt/Mobiup -/mnt -/srv/backups
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictSUIDSGID=yes
LockPersonality=yes
KillMode=control-group
RuntimeMaxSec=40s
TimeoutStopSec=4s
MemoryMax=1G
TasksMax=64
