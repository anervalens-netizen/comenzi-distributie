[Unit]
Description=Mobiup partner geocoding queue
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=operator
Group=operator
WorkingDirectory=/opt/Mobiup/comenzi-distributie
ExecStart=/usr/bin/flock -n -E 75 /storage/comenzi-distributie/geocoding/run.lock /usr/bin/python3 /opt/Mobiup/comenzi-distributie/tools/run-partner-geocode-worker.py
SuccessExitStatus=75
TimeoutStartSec=6h
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/storage/comenzi-distributie
MemoryMax=384M

