[Unit]
Description=Backup Mobiup comenzi distributie to NAS
After=network-online.target mobiup-comenzi-distributie.service

[Service]
Type=oneshot
User=operator
UMask=0077
ExecStart=/usr/bin/python3 /opt/Mobiup/comenzi-distributie/deploy/backup.py
NoNewPrivileges=true
Nice=10
IOSchedulingClass=idle
CPUQuota=100%
