{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "npm": "12.0.2"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node tools/private-source-maps.mjs dist/client .private-source-maps/client",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "build:server": "node tools/build-server.mjs",
    "start:server": "node dist/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "check": "bash tools/check-all.sh",
    "prepare:public": "node tools/prepare-public-data.mjs",
    "postinstall": "node tools/prepare-public-data.mjs",
    "prebuild": "node tools/prepare-public-data.mjs",
    "prebuild:server": "node tools/prepare-public-data.mjs",
    "pretypecheck": "node tools/prepare-public-data.mjs",
    "precheck": "node tools/prepare-public-data.mjs && npm run check:privacy",
    "build:private": "node tools/build-private.mjs",
    "check:privacy": "node .github/test-public-data.mjs && node .github/test-public-history.mjs && node .github/check-public-data.mjs",
    "prepare": "node .github/install-hooks.mjs",
    "test:client-sales": "node tools/test-client-sales.mjs",
    "test:client-sales:browser": "node tools/test-client-sales-browser.mjs",
    "test:client-sales:http": "node tools/test-client-sales-http.mjs",
    "bench:reports": "node tools/bench-reports.mjs",
    "bench:inventory": "node tools/bench-inventory.mjs",
    "bench:http": "node tools/bench-http.mjs",
    "test:performance-lab": "node tools/test-performance-lab.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@mmmike/web-push": "1.3.0",
    "@sentry/node": "10.66.0",
    "@sentry/react": "10.66.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "fflate": "^0.8.3",
    "input-otp": "1.4.2",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.31.0",
    "maplibre-gl": "6.11.2",
    "react": "19.3.0",
    "react-day-picker": "9.8.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.3.0",
    "recharts": "3.8.0",
    "saxes": "6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@cloudflare/workers-types": "5.20260914.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vercel/nft": "1.11.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.18.0",
    "tailwindcss": "4.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.131.2"
  },
  "type": "module",
  "packageManager": "npm@12.0.2",
  "overrides": {
    "undici": "7.29.1",
    "tinypool": "2.2.0",
    "miniflare": {
      "sharp": "0.35.5"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
